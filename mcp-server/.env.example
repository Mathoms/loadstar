# Loadstar MCP server config.
# These can also be passed with `claude mcp add --env ...` (see README).
# NEVER commit a real key.

# Base URL of the Loadstar api service. The /api prefix is appended for you.
LOADSTAR_API_URL=http://localhost:8080

# API key for apiKeyAuth (guards all /api routes).
LOADSTAR_API_KEY=

# The header apiKeyAuth actually reads. CONFIRM against
# api/src/middleware/security.js — this is the one value not read off the
# source. If tool calls come back 401, this is the line to fix.
LOADSTAR_API_KEY_HEADER=x-api-key

# Debug runs store REAL Authorization tokens in plaintext (runs.debug_trace,
# disclosed in SECURITY.md). Everything an MCP tool returns lands in an LLM
# context window, so debug_trace is STRIPPED by default. Flip this only if
# you mean it.
LOADSTAR_EXPOSE_DEBUG_TRACE=false
